#!/bin/bash
C_CYAN='\033[0;36m'; C_GREEN='\033[0;32m'; C_YELLOW='\033[1;33m'; C_RED='\033[0;31m'
C_DIM='\033[2m'; C_BOLD='\033[1m'; C_RESET='\033[0m'

pick_session() {
  clear
  echo ""
  echo -e "  ${C_CYAN}${C_BOLD}⚡ Chọn tmux session${C_RESET}"
  echo -e "  ${C_DIM}──────────────────────${C_RESET}"
  echo ""

  sessions=$(tmux ls -F '#{session_name}' 2>/dev/null)
  if [ -z "$sessions" ]; then
    echo -e "  ${C_YELLOW}⚠  Không có session nào đang chạy${C_RESET}"
    read -p "  Press enter"
    return
  fi

  IFS=$'\n' read -rd '' -a arr <<< "$sessions"
  for i in "${!arr[@]}"; do
    echo -e "  ${C_GREEN}$((i+1)).${C_RESET} ${arr[$i]}"
  done
  echo ""
  read -p "  Chọn số (Enter để thoát): " n
  [ -z "$n" ] && return
  idx=$((n-1))
  [ "$idx" -lt 0 ] || [ "$idx" -ge "${#arr[@]}" ] && echo -e "  ${C_RED}Invalid${C_RESET}" && read -p "  Press enter" && return
  session="${arr[$idx]}"

  while true; do
    clear
    echo ""
    echo -e "  ${C_CYAN}${C_BOLD}● ${session}${C_RESET}"
    echo -e "  ${C_DIM}──────────────────────${C_RESET}"
    echo ""
    echo -e "  ${C_GREEN}1.${C_RESET} 🔗  Đính kèm session"
    echo -e "  ${C_GREEN}2.${C_RESET} ❌  Kill session"
    echo -e "  ${C_GREEN}3.${C_RESET} ✏️   Đổi tên"
    echo -e "  ${C_GREEN}4.${C_RESET} 📋  Windows"
    echo -e "  ${C_GREEN}0.${C_RESET} Quay lại"
    echo ""
    read -p "  Chọn: " a
    case "$a" in
      1) tmux attach -t "$session"; break ;;
      2) tmux kill-session -t "$session" && echo -e "  ${C_GREEN}✅ Killed${C_RESET}" || echo -e "  ${C_RED}❌ Failed${C_RESET}"; read -p "  Press enter"; break ;;
      3) read -p "  Tên mới: " new; tmux rename-session -t "$session" "$new" && echo -e "  ${C_GREEN}✅ Done${C_RESET}" && session="$new" || echo -e "  ${C_RED}❌ Failed${C_RESET}"; read -p "  Press enter" ;;
      4) tmux list-windows -t "$session" -F '  #I:#W'; read -p "  Press enter" ;;
      0) break ;;
    esac
  done
}

if [ -n "$TMUX" ]; then
  exec tmux display-menu -T " #[fg=#7dcfff,bold]⌘ Quick Menu " -x C -y C \
    "  New Window      " n "new-window -c '#{pane_current_path}'" \
    "  Split H         " - "split-window -h -c '#{pane_current_path}'" \
    "  Split V         " | "split-window -v -c '#{pane_current_path}'" \
    "" \
    "  Sessions        " s "choose-tree -Zs" \
    "  Detach          " d "detach-client"
fi

while true; do
  clear
  echo ""
  echo -e "  ${C_CYAN}${C_BOLD}⌘ Tmux Manager${C_RESET}  ${C_DIM}──  outside tmux${C_RESET}"
  echo -e "  ${C_DIM}──────────────────────────${C_RESET}"
  echo ""
  echo -e "  ${C_GREEN}${C_BOLD}1.${C_RESET} ⚡  Chọn session đang chạy"
  echo -e "  ${C_GREEN}${C_BOLD}2.${C_RESET} 📋  Danh sách sessions"
  echo -e "  ${C_GREEN}${C_BOLD}3.${C_RESET} ➕  Tạo session mới"
  echo -e "  ${C_GREEN}${C_BOLD}4.${C_RESET} ❌  Kill session"
  echo ""
  echo -e "  ${C_GREEN}${C_BOLD}5.${C_RESET} 📖  Hướng dẫn tmux"
  echo -e "  ${C_GREEN}${C_BOLD}6.${C_RESET} 🖥   Htop"
  echo -e "  ${C_GREEN}${C_BOLD}7.${C_RESET} 🐳  Docker ps"
  echo ""
  echo -e "  ${C_GREEN}${C_BOLD}0.${C_RESET} Thoát"
  echo ""
  echo -ne "  ${C_YELLOW}❯${C_RESET} "
  read -n 1 c; echo
  case "$c" in
    1) pick_session ;;
    2) tmux ls 2>/dev/null || echo "  No sessions"; read -p "  Press enter" ;;
    3) read -p "  Name: " s; tmux new-session -d -s "$s" && echo "  Created: $s" || echo "  Failed"; read -p "  Press enter" ;;
    4) read -p "  Name: " s; tmux kill-session -t "$s" 2>/dev/null && echo "  Killed: $s" || echo "  Not found"; read -p "  Press enter" ;;
    5) cat ~/.tmux/help.txt 2>/dev/null || echo "  No help file"; read -p "  Press enter" ;;
    6) htop 2>/dev/null || top ;;
    7) docker ps 2>/dev/null || echo "  Docker not available"; read -p "  Press enter" ;;
    0) break ;;
  esac
done
echo ""
